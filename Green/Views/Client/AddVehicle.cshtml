@section Scripts {
	<script>
		const carModels = {
			"BMW": ["3 Series", "5 Series", "7 Series", "X1", "X3", "X5", "X6", "X7", "M3", "M5"],
			"Audi": ["A3", "A4", "A6", "A8", "Q3", "Q5", "Q7", "Q8", "TT", "RS6"],
			"Mercedes-Benz": ["A-Class", "C-Class", "E-Class", "S-Class", "GLA", "GLC", "GLE", "GLS", "G-Class", "AMG GT"],
			"Toyota": ["Camry", "Corolla", "RAV4", "Land Cruiser", "Prado", "Highlander", "Hilux", "Yaris", "C-HR", "Supra"],
			"Volkswagen": ["Polo", "Golf", "Passat", "Tiguan", "Touareg", "Jetta", "Arteon", "Caravelle", "Multivan", "Taos"],
			"Hyundai": ["Solaris", "Elantra", "Sonata", "Creta", "Tucson", "Santa Fe", "Palisade", "I30", "Genesis G80", "Staria"],
			"KIA": ["Rio", "Ceed", "Cerato", "K5", "Optima", "Sportage", "Sorento", "Telluride", "Soul", "Stinger"],
			"LADA": ["Vesta", "Granta", "Niva Legend", "Niva Travel", "XRAY", "Largus", "Priora", "Kalina", "2107", "2114"],
			"Nissan": ["Qashqai", "X-Trail", "Juke", "Murano", "Terrano", "Almera", "Teana", "Patrol", "Navara", "GT-R"],
			"Ford": ["Focus", "Mondeo", "Fiesta", "Kuga", "Explorer", "EcoSport", "Mustang", "Ranger", "Transit", "Fusion"]
		};

		function updateModels(selectedModel = null) {
			const brand = document.getElementById("brandSelect").value;
			const modelSelect = document.getElementById("modelSelect");
			modelSelect.innerHTML = '<option value="">-- Выберите модель --</option>';

			if (brand && carModels[brand]) {
				carModels[brand].forEach(model => {
					const option = document.createElement("option");
					option.value = model;
					option.text = model;
					if (selectedModel && model === selectedModel) {
						option.selected = true;
					}
					modelSelect.appendChild(option);
				});
			}
		}

		function combineLicensePlate() {
			const number = document.getElementById("licenseNumber").value.trim().toUpperCase();
			const region = document.getElementById("regionSelect").value;
			document.getElementById("fullLicensePlate").value = `${number} ${region}`;
		}

		// Восстановление выбранной модели при перезагрузке страницы с ошибкой валидации
		document.addEventListener("DOMContentLoaded", function() {
			const currentBrand = "@Model?.Make";
			const currentModel = "@Model?.Model";
			if (currentBrand) {
				document.getElementById("brandSelect").value = currentBrand;
				updateModels(currentModel);
			}
		});
	</script>
}
