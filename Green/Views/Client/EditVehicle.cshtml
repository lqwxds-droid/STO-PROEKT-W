@model Green.Models.Vehicle
@{
	ViewData["Title"] = "Редактирование автомобиля";
}

<div class="page-heading">
	<div><span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ / ГАРАЖ</span><h1>Редактирование автомобиля</h1><p>Обновите данные автомобиля в своём гараже.</p></div>
</div>

<div class="row justify-content-center">
	<div class="col-lg-7">
		<div class="card">
			<div class="card-body">
				<form asp-action="EditVehicle" method="post">
					@Html.AntiForgeryToken()
					<input type="hidden" asp-for="Id" />
					<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
					<div class="row g-3">
						<div class="col-md-6"><label asp-for="Make" class="form-label"></label><input asp-for="Make" class="form-control" /><span asp-validation-for="Make" class="text-danger"></span></div>
						<div class="col-md-6"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /><span asp-validation-for="Model" class="text-danger"></span></div>
						<div class="col-md-6"><label asp-for="Year" class="form-label"></label><input asp-for="Year" type="number" min="1950" max="@DateTime.Now.Year" class="form-control" /><span asp-validation-for="Year" class="text-danger"></span></div>
						<div class="col-md-6"><label asp-for="LicensePlate" class="form-label"></label><input asp-for="LicensePlate" class="form-control text-uppercase" /><span asp-validation-for="LicensePlate" class="text-danger"></span></div>
						<div class="col-12"><label asp-for="VIN" class="form-label"></label><input asp-for="VIN" maxlength="17" class="form-control text-uppercase font-monospace" /><span asp-validation-for="VIN" class="text-danger"></span></div>
					</div>
					<div class="d-flex justify-content-between mt-4"><a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Отмена</a><button type="submit" class="btn btn-success">Сохранить изменения</button></div>
				</form>
			</div>
		</div>
	</div>
</div>
