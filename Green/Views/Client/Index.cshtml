@model IEnumerable<Green.Models.ServiceRequest>
@using Green.Infrastructure
@using Green.Models

@{
	ViewData["Title"] = "Мой кабинет";
	var vehicles = ViewBag.MyVehicles as List<Green.Models.Vehicle> ?? new List<Green.Models.Vehicle>();
}

<div class="page-heading">
	<div>
		<span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ</span>
		<h1>Мой гараж и заказы</h1>
		<p>Добавьте автомобили и запишитесь на обслуживание</p>
	</div>
</div>
<div class="d-flex gap-2 mb-4">
	<a asp-action="Book" class="btn btn-primary"><i class="bi bi-calendar2-check"></i> Записаться на обслуживание</a>
	<a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary"><i class="bi bi-car-front"></i> Автомобили</a>
</div>

<!-- Quick Stats -->
<div class="row g-3 mb-4">
	<div class="col-md-3 col-sm-6">
		<div class="card">
			<div class="card-body text-center">
				<i class="bi bi-car-front" style="font-size: 2rem; color: var(--color-primary); margin-bottom: 0.5rem;"></i>
				<div class="text-muted small">Мои авто</div>
				<div class="fs-3 fw-bold text-primary">@vehicles.Count</div>
			</div>
		</div>
	</div>
	<div class="col-md-3 col-sm-6">
		<div class="card">
			<div class="card-body text-center">
				<i class="bi bi-file-earmark-check" style="font-size: 2rem; color: var(--color-info); margin-bottom: 0.5rem;"></i>
				<div class="text-muted small">Всего заказов</div>
				<div class="fs-3 fw-bold text-info">@Model.Count()</div>
			</div>
		</div>
	</div>
	<div class="col-md-3 col-sm-6">
		<div class="card">
			<div class="card-body text-center">
				<i class="bi bi-hourglass-split" style="font-size: 2rem; color: var(--color-warning); margin-bottom: 0.5rem;"></i>
				<div class="text-muted small">В работе</div>
				<div class="fs-3 fw-bold text-warning">@Model.Count(r => r.Status == Green.Models.RequestStatus.InProgress)</div>
			</div>
		</div>
	</div>
	<div class="col-md-3 col-sm-6">
		<div class="card">
			<div class="card-body text-center">
				<i class="bi bi-check-circle" style="font-size: 2rem; color: var(--color-success); margin-bottom: 0.5rem;"></i>
				<div class="text-muted small">Готовы</div>
				<div class="fs-3 fw-bold text-success">@Model.Count(r => r.Status == Green.Models.RequestStatus.Completed)</div>
			</div>
		</div>
	</div>
</div>

<!-- Vehicles Section -->
<h3 class="mb-3"><i class="bi bi-car-front"></i> Мои автомобили</h3>
<div class="row g-3 mb-4">
	@if (!vehicles.Any())
	{
		<div class="col-12">
			<div class="card">
				<div class="card-body text-center py-5 text-muted">
					<i class="bi bi-car-front" style="font-size: 3rem; opacity: 0.3;"></i>
					<p class="mt-3">Автомобили еще не добавлены</p>
					<a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-primary">
						Добавить автомобиль в профиле
					</a>
				</div>
			</div>
		</div>
	}
	else
	{
		@foreach (var vehicle in vehicles)
		{
			<div class="col-md-6 col-lg-4">
				<div class="card">
					<div class="card-body">
						<div style="display: flex; align-items: start; justify-content: space-between; margin-bottom: 1rem;">
							<div>
								<h5 class="card-title mb-1">@vehicle.Make @vehicle.Model</h5>
								<small class="text-muted">@vehicle.Year · @vehicle.LicensePlate</small>
							</div>
							<span class="badge badge-primary">@vehicle.VIN</span>
						</div>
						<a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-secondary">
							<i class="bi bi-gear"></i> Управление в профиле
						</a>
					</div>
				</div>
			</div>
		}
	}
</div>

<!-- Секция заказов -->
<h3 class="mb-3"><i class="bi bi-calendar2-check"></i> Мои заказы</h3>
<div class="card">
	<div class="card-body">
		@if (!Model.Any())
		{
			<div class="text-center py-5 text-muted">
				<i class="bi bi-calendar2-x" style="font-size: 3rem; opacity: 0.3;"></i>
				<p class="mt-3">Заказы еще не созданы</p>
				<a asp-action="Book" class="btn btn-sm btn-primary">
					Записаться на обслуживание
				</a>
			</div>
		}
		else
		{
			<div class="table-responsive">
				<table class="table">
					<thead>
						<tr>
							<th>Автомобиль</th>
							<th>Дата</th>
							<th>Статус</th>
							<th>Описание</th>
							<th>Действие</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var booking in Model.OrderByDescending(x => x.ScheduledDate))
						{
							var statusBadgeType = booking.Status switch
							{
								Green.Models.RequestStatus.Planned => "info",
								Green.Models.RequestStatus.InProgress => "warning",
								Green.Models.RequestStatus.Completed => "success",
								Green.Models.RequestStatus.Cancelled => "danger",
								Green.Models.RequestStatus.AwaitingApproval => "warning",
								_ => "secondary"
							};

							<tr>
								<td>
									<strong>@booking.Vehicle?.Make @booking.Vehicle?.Model</strong>
									<br />
									<small class="text-muted">@booking.Vehicle?.LicensePlate</small>
								</td>
								<td>
									<small>@booking.ScheduledDate.ToString("dd.MM.yyyy HH:mm")</small>
								</td>
								<td>
									<span class="badge badge-@statusBadgeType">@booking.Status.GetRussianName()</span>
								</td>
								<td>
									<small>@booking.Description</small>
								</td>
								<td>
									<a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Подробности</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>
