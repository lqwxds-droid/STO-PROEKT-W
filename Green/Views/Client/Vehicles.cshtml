@model IEnumerable<Green.Models.Vehicle>

@{
	ViewData["Title"] = "Мой автопарк";
}

<div class="page-heading">
	<div><span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ / ГАРАЖ</span><h1>Мои автомобили</h1><p>Управление транспортными средствами и быстрая запись на сервис.</p></div>
	<a asp-action="AddVehicle" class="btn btn-success">
		Добавить автомобиль <i class="bi bi-plus-lg"></i>
	</a>
</div>

<!-- карточки автомобилей -->
<div class="row g-4 mb-5">
	@if (!Model.Any())
	{
		<div class="col-12">
			<div class="card p-5 text-center border-dashed border-secondary">
				<div class="fs-1 text-muted mb-3"><i class="bi bi-car-front"></i></div>
				<h4 class="text-light">У вас пока нет добавленных автомобилей</h4>
				<p class="text-muted">Зарегистрируйте авто по VIN-коду, чтобы подбор запчастей и запись занимали 1 клик.</p>
				<div class="mt-2">
					<a asp-action="AddVehicle" class="btn btn-success px-4">
						Добавить первый автомобиль
					</a>
				</div>
			</div>
		</div>
	}
	else
	{
		@foreach (var vehicle in Model)
		{
			<div class="col-md-6 col-lg-4">
				<div class="vehicle-card p-3 rounded bg-dark text-light h-100 shadow-sm border-secondary">
					<div class="d-flex justify-content-between align-items-start">
						<div>
							<h5 class="fw-bold mb-0">@vehicle.Make @vehicle.Model</h5>
							<div class="small text-muted">VIN: <span class="font-monospace text-light">@(string.IsNullOrEmpty(vehicle.VIN) ? "Не указан" : vehicle.VIN)</span></div>
						</div>
						<div class="text-end">
							<div class="badge bg-dark border border-secondary text-warning font-monospace">
								@(string.IsNullOrEmpty(vehicle.LicensePlate) ? "НЕ УКАЗАН" : vehicle.LicensePlate)
							</div>
							<div class="badge bg-dark border border-secondary text-light mt-2">@vehicle.Year г.в.</div>
						</div>
					</div>
					<div class="mt-3 d-flex gap-2">
						<a asp-action="Book" asp-route-vehicleId="@vehicle.Id" class="btn btn-sm btn-outline-success w-100">Записать на ТО</a>
						<a asp-action="EditVehicle" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
						<form asp-action="DeleteVehicle" asp-route-id="@vehicle.Id" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить этот автомобиль?');" class="m-0">
							@Html.AntiForgeryToken()
							<button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить"><i class="bi bi-trash"></i></button>
						</form>
					</div>
				</div>
			</div>
		}
	}
</div>

<!-- Модальное окно добавления машины -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" aria-labelledby="addVehicleModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content bg-dark text-light border border-secondary shadow-lg">
			<div class="modal-header border-secondary">
				<h5 class="modal-title fw-bold text-success" id="addVehicleModalLabel">Добавление автомобиля</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
			</div>
			<form asp-action="AddVehicle" method="post">
				@Html.AntiForgeryToken()
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label text-light">VIN-код (17 символов)</label>
						<input name="VIN" type="text" class="form-control text-uppercase font-monospace" placeholder="например, WBA330C000AH12345" maxlength="17" required />
						<div class="form-text text-muted">Используется автомехаником для подбора оригинальных комплектующих.</div>
					</div>
					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label text-light">Марка</label>
							<input name="Make" type="text" class="form-control" placeholder="BMW, Audi, Toyota..." required />
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label text-light">Модель</label>
							<input name="Model" type="text" class="form-control" placeholder="X5, A6, Camry..." required />
						</div>
					</div>
					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label text-light">Год выпуска</label>
							<input name="Year" type="number" class="form-control" min="1950" max="@DateTime.Now.Year" value="@DateTime.Now.Year" required />
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label text-light">Гос. номер</label>
							<input name="LicensePlate" type="text" class="form-control text-uppercase" placeholder="A 001 AA 77" />
						</div>
					</div>
				</div>
				<div class="modal-footer border-secondary">
					<button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Отмена</button>
					<button type="submit" class="btn btn-success px-4">Сохранить авто</button>
				</div>
			</form>
		</div>
	</div>
</div>

