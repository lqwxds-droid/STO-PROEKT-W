@using Green.Infrastructure
@using Green.Models
@model AdminDashboardViewModel

@{
	ViewData["Title"] = "Панель админа";
}
<div class="page-heading">
	<div>
		<span class="eyebrow">АДМИНИСТРАТОР</span>
		<h1>Панель управления</h1>
		<p>Управление пользователями, ролями и заказами</p>
	</div>
	<a href="@Url.Action("CreateEmployee")" class="btn btn-primary">
		<i class="bi bi-person-plus"></i> Добавить сотрудника
	</a>
</div>

<!-- Навигация по вкладкам -->
<ul class="nav nav-tabs mb-4" role="tablist">
	<li class="nav-item" role="presentation">
		<button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab" aria-selected="false">
			<i class="bi bi-people"></i> Пользователи
		</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link active" id="requests-tab" data-bs-toggle="tab" data-bs-target="#requests" type="button" role="tab" aria-selected="true">
			<i class="bi bi-list-check"></i> Заказы
		</button>
	</li>
</ul>

<!-- Содержимое вкладок -->
<div class="tab-content">
	<!-- Вкладка: Пользователи -->
	<div class="tab-pane fade" id="users" role="tabpanel">
		<div class="card">
			<div class="card-header">
				<h5 class="mb-0">
					<i class="bi bi-people"></i> Управление пользователями
				</h5>
			</div>
			<div class="card-body">
				<div class="table-responsive">
					<table class="table">
						<thead>
							<tr>
								<th>ФИО</th>
								<th>Email</th>
								<th>Телефон</th>
								<th>Роль</th>
								<th>Действие</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var user in Model.Users)
							{
								<tr>
									<td>@user.FullName</td>
									<td>@user.Email</td>
									<td>@user.PhoneNumber</td>
									<td><span class="badge badge-primary">@user.Role.GetDisplayName()</span></td>
									<td>
										<a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
									</td>
								</tr>
							}
							@if (Model.Users.Count == 0)
							{
								<tr><td colspan="5" class="text-center text-muted">Пользователей пока нет.</td></tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<!-- Вкладка: Заказы -->
	<div class="tab-pane fade show active" id="requests" role="tabpanel">
		<div class="card">
			<div class="card-header">
				<h5 class="mb-0">
					<i class="bi bi-list-check"></i> Все заказы
				</h5>
			</div>
			<div class="card-body">
				@if (!Model.Requests.Any())
				{
					<div class="text-center py-5 text-muted">
						<i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
						<p class="mt-3">Нет заказов</p>
					</div>
				}
				else
				{
					<div class="table-responsive">
						<table class="table">
							<thead>
								<tr>
									<th>Номер</th>
									<th>Клиент</th>
									<th>Автомобиль</th>
									<th>Услуги</th>
										<th>Мастер</th>
									<th>Статус</th>
									<th>Дата приёма</th>
									<th>Действие</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var request in Model.Requests)
								{
									var statusColor = request.Status switch
									{
										Green.Models.RequestStatus.Planned => "info",
										Green.Models.RequestStatus.InProgress => "warning",
										Green.Models.RequestStatus.Completed => "success",
										Green.Models.RequestStatus.Cancelled => "danger",
										Green.Models.RequestStatus.AwaitingApproval => "warning",
										_ => "secondary"
									};

									<tr>
										<td><strong>#@request.Id</strong></td>
										<td>@request.Client?.FullName</td>
										<td>@request.Vehicle?.Make @request.Vehicle?.Model</td>
										<td>
											@if (request.SelectedServices != null && request.SelectedServices.Any())
											{
												<small>@string.Join(", ", request.SelectedServices.Select(s => s.Name))</small>
											}
										</td>
						<td>@(request.AssignedEmployee == null ? "Не назначен" : string.IsNullOrWhiteSpace(request.AssignedEmployee.FullName) ? request.AssignedEmployee.Email ?? request.AssignedEmployee.UserName : request.AssignedEmployee.FullName)</td>
										<td>
											<span class="badge badge-@statusColor">@request.Status.GetRussianName()</span>
										</td>
										<td>
											<small>@request.CreatedAt.ToString("dd.MM.yyyy")</small>
										</td>
										<td>
										@if (request.Status is RequestStatus.AwaitingApproval or RequestStatus.Planned)
										{
							<a asp-page="/ServiceRequests/Edit" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">
								<i class="bi bi-pencil-square"></i> Просмотр / редактирование
											</a>
											<form asp-action="CancelRequest" method="post" class="d-inline">
													@Html.AntiForgeryToken()
													<input type="hidden" name="requestId" value="@request.Id" />
													<button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
											</form>
											}
						else
						{
							<a asp-page="/ServiceRequests/Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">
								<i class="bi bi-eye"></i> Просмотр
							</a>
						}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</div>
	</div>
</div>
