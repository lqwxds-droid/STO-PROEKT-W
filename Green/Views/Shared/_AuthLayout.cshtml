<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] — Green Auto</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="auth-page auth-layout-page">
	<header class="auth-header">
		<a class="auth-logo" asp-controller="Home" asp-action="Index">
			<span class="auth-logo-mark">G</span>
			<span>Green <b>Auto</b></span>
		</a>
	</header>

	<main role="main" class="auth-main">
		<div class="auth-container">
			@RenderBody()
		</div>
	</main>

	<footer class="auth-footer">
		© @DateTime.Now.Year Green Auto · Автосервис, которому можно доверять
	</footer>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
