@model ErrorViewModel
@{
	ViewData["Title"] = "Ошибка";
}

<div class="page-heading">
	<div>
		<span class="eyebrow">Системная ошибка</span>
		<h1>Что-то пошло не так</h1>
		<p>Мы столкнулись с неожиданной ошибкой. Пожалуйста, попробуйте ещё раз или свяжитесь с поддержкой.</p>
	</div>
</div>

<div class="row">
	<div class="col-lg-8">
		<div class="card">
			<div class="card-body">
				<div class="text-center py-5">
					<i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem; color: var(--color-danger); margin-bottom: 1rem;"></i>
					<h3 class="text-danger">Ошибка</h3>
					<p class="text-muted mt-2">На странице, к которой вы пытаетесь получить доступ, произошла ошибка.</p>
				</div>

				@if (Model.ShowRequestId)
				{
					<div class="alert alert-info">
						<strong>Идентификатор запроса:</strong>
						<code>@Model.RequestId</code>
					</div>
				}

				<div class="d-flex gap-2 justify-content-center">
					<a class="btn btn-primary" asp-controller="Home" asp-action="Index">
						<i class="bi bi-house"></i> На главную
					</a>
					<button class="btn btn-outline-primary" onclick="window.history.back()">
						<i class="bi bi-arrow-left"></i> Назад
					</button>
				</div>
			</div>
		</div>
	</div>

	<div class="col-lg-4">
		<div class="card">
			<div class="card-body">
				<h5>Нужна помощь?</h5>
				<p class="text-muted small">Если вы продолжаете испытывать проблемы, пожалуйста, свяжитесь с нашей командой поддержки.</p>
				<a href="mailto:support@greenato.com" class="btn btn-sm btn-outline-primary w-100">
					<i class="bi bi-envelope"></i> Написать в поддержку
				</a>
			</div>
		</div>
	</div>
</div>
